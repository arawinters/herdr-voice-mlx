#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
"${repo_root}/scripts/local-openlive-source"
cd "${repo_root}/local-openlive"
# Minimums match local-openlive/package.json engines; pnpm-lock.yaml stays exact either way.
node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' || { echo "Node 22 or later is required" >&2; exit 1; }
test "$(pnpm --version | cut -d. -f1)" -ge 10 || { echo "pnpm 10 or later is required" >&2; exit 1; }
# Same settings, names and defaults as LocalRuntime.swift. Ollama is only needed when the brain is Ollama (port 11434).
brain_url=${HERDR_VOICE_LOCAL_BRAIN_URL:-${HERDR_LOCAL_BRAIN_URL:-http://127.0.0.1:11434/v1}}
brain_model=${HERDR_VOICE_LOCAL_BRAIN_MODEL:-${HERDR_LOCAL_BRAIN_MODEL:-qwen3.5:4b}}
case "${brain_url}" in
  *:11434|*:11434/*)
    command -v ollama >/dev/null 2>&1 || { echo "Ollama is required for the default local brain" >&2; exit 1; }
    ollama show "${brain_model}" >/dev/null 2>&1 || ollama pull "${brain_model}"
    ;;
  *)
    echo "Using the local brain at ${brain_url} (${brain_model}); it must already be serving that model."
    ;;
esac
pnpm install --frozen-lockfile
pnpm build
node scripts/setup-models.mjs
node scripts/check-runtime.mjs
